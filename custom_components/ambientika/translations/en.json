        "data_description": {
          "poll_interval": "How often the status of every unit is read from the cloud.",
          "availability_failure_threshold": "A unit keeps its last values until this many readings in a row have failed.",
          "command_coalesce_ms": "Commands for the same unit within this time are sent in one call. 0 sends every command at once.",
          "average_window_min": "In minutes, at least twenty reading intervals.",
          "average_window_devices": "Name as in the app or serial number, then the minutes, for example: Bathroom=10, A1B2C3D4E5F6=60",
          "humidity_avg_hysteresis": "In percentage points; the value only moves once the mean has changed by this much. 0 = none.",
          "humidity_avg_hysteresis_devices": "For example: Bathroom=1, Bedroom=0",
          "temperature_avg_hysteresis": "In °C. 0 = none.",
          "temperature_avg_hysteresis_devices": "For example: Bedroom=0.3",
          "temperature_avg_window_min": "In minutes. 0 = the same window as for the humidity.",
          "slave_filter_soft_reset": "A Slave keeps its own filter counter, which the cloud cannot clear. With this option the filter reset records the maintenance: the filter status reads good, the unit's own value stays visible as the raw filter status.",
          "filter_ack_ttl_days": "After this many days the filter status of the unit itself is shown again."
        }
      },
      "radon": {
